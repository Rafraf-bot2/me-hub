# TMDB — token de lecture API (https://www.themoviedb.org/settings/api)
TMDB_READ_TOKEN=

# Letterboxd — auth pour scraper tous les films notés (Phase 1)
LB_USER=
LB_PASS=
# Plan B si login headless bloqué : cookie de session manuel
LB_COOKIE=

# Hevy — clé API perso pour /sport (https://hevy.com/settings?developer, nécessite Hevy Pro)
HEVY_API_KEY=
