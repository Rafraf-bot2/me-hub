---
import cine from '../data/cine.json';
import CineSpace from '../components/CineSpace.jsx';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ciné — rafraf</title>
    <meta name="description" content={`Galerie de frames — ${cine.films.length} films, ${cine.films.reduce((n, f) => n + f.frames.length, 0)} captures.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,400;9..144,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="cine-root">
      <CineSpace client:only="react" films={cine.films} />
      <noscript>
        <p class="cn-nojs">Active JavaScript pour explorer la galerie en 3D.</p>
      </noscript>
    </div>

    <style is:global>
      :root {
        --ink: #08080b;
        --paper: #e7e2d6;
        --muted: #8a8780;
        --gold: #d8b25a;
        --mono: 'DM Mono', ui-monospace, monospace;
        --serif: 'Fraunces', Georgia, serif;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; height: 100%; background: var(--ink); }
      .cine-root {
        position: relative;
        width: 100vw;
        height: 100svh;
        overflow: hidden;
        background: var(--ink);
        cursor: grab;
      }
      .cine-root:active { cursor: grabbing; }
      .cine-root canvas { display: block; }

      .cn-vig {
        position: absolute; inset: 0; pointer-events: none;
        box-shadow: inset 0 0 200px 60px rgba(0, 0, 0, 0.85);
      }
      .cn-hud { position: absolute; font-family: var(--mono); z-index: 5; }
      .cn-tl { top: 22px; left: 26px; pointer-events: none; }
      .cn-tr { top: 22px; right: 26px; }
      .cn-bl { bottom: 22px; left: 26px; pointer-events: none; }
      .cn-br { bottom: 22px; right: 26px; pointer-events: none; }
      .cn-title { color: var(--paper); font-size: 14px; letter-spacing: 0.2em; }
      .cn-sub { color: var(--muted); font-size: 11px; letter-spacing: 0.12em; margin-top: 4px; }
      .cn-hint { color: var(--muted); font-size: 11px; letter-spacing: 0.08em; }
      .cn-hov { color: var(--gold); font-size: 11px; letter-spacing: 0.1em; transition: opacity 0.25s; }
      .cn-btn {
        font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; color: var(--paper);
        background: rgba(20, 20, 24, 0.6); border: 1px solid rgba(231, 226, 214, 0.25);
        border-radius: 6px; padding: 7px 13px; cursor: pointer;
      }
      .cn-btn:hover { border-color: var(--gold); color: var(--gold); }

      .cn-overlay {
        position: absolute; inset: 0; z-index: 10; display: flex;
        align-items: center; justify-content: center;
        background: rgba(6, 6, 9, 0.84); backdrop-filter: blur(3px);
      }
      .cn-detail { display: flex; gap: 26px; max-width: 760px; padding: 0 28px; align-items: flex-start; }
      .cn-poster { width: 150px; aspect-ratio: 2/3; object-fit: cover; border-radius: 4px; border: 1px solid rgba(231, 226, 214, 0.2); flex: none; }
      .cn-info { font-family: var(--mono); color: var(--paper); }
      .cn-dtitle { font-family: var(--serif); font-size: 34px; line-height: 1.05; margin-bottom: 8px; }
      .cn-dmeta { font-size: 12px; color: var(--muted); letter-spacing: 0.08em; margin-bottom: 18px; }
      .cn-frames { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 18px; }
      .cn-frames img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 3px; }
      .cn-actions { display: flex; gap: 10px; align-items: center; }
      .cn-lb { color: var(--gold); font-size: 11px; text-decoration: none; border: 1px solid rgba(216, 178, 90, 0.4); border-radius: 5px; padding: 7px 12px; }
      .cn-lb:hover { background: rgba(216, 178, 90, 0.12); }
      .cn-actions button, .cn-aboutpane button {
        font-family: var(--mono); font-size: 11px; color: var(--paper); background: transparent;
        border: 1px solid rgba(231, 226, 214, 0.25); border-radius: 5px; padding: 7px 12px; cursor: pointer;
      }

      .cn-aboutpane { max-width: 460px; font-family: var(--mono); color: #cfcabf; padding: 0 28px; }
      .cn-alabel { font-size: 13px; letter-spacing: 0.22em; color: var(--gold); margin-bottom: 16px; }
      .cn-aboutpane p { font-size: 14px; line-height: 1.9; margin: 0 0 20px; }

      .cn-sheet {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 2px; padding: 2px; background: var(--ink); min-height: 100svh;
      }
      .cn-cell { position: relative; display: block; aspect-ratio: 16/9; overflow: hidden; text-decoration: none; }
      .cn-cell img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.85); transition: filter 0.3s; }
      .cn-cell:hover img { filter: brightness(1.05); }
      .cn-cell span {
        position: absolute; left: 8px; bottom: 7px; right: 8px; font-family: var(--mono);
        font-size: 10px; letter-spacing: 0.06em; color: var(--paper); text-shadow: 0 1px 3px #000;
      }
      .cn-nojs { color: var(--muted); font-family: var(--mono); padding: 40px; }
    </style>
  </body>
</html>
